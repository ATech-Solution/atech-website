{
  "name": "atech-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "devturbo": "next dev --turbopack",
    "build": "next build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "postbuild": "npm run generate:importmap",
    "postinstall": "npm run generate:types && npm run generate:importmap",
    "start": "node .next/standalone/server.js",
    "start:prod": "npm run build && node .next/standalone/server.js",
    "lint": "next lint",
    "seed": "tsx src/scripts/seed.ts",
    "generate:types": "NODE_OPTIONS='--import tsx' payload generate:types",
    "generate:importmap": "NODE_OPTIONS='--import tsx' payload generate:importmap",
    "payload": "NODE_OPTIONS='--import tsx' payload",
    "migrate:create": "NODE_OPTIONS='--import tsx' payload migrate:create",
    "migrate": "NODE_OPTIONS='--import tsx' payload migrate"
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@payloadcms/db-sqlite": "3.33.0",
    "@payloadcms/next": "3.33.0",
    "@payloadcms/plugin-form-builder": "3.33.0",
    "@payloadcms/plugin-nested-docs": "3.33.0",
    "@payloadcms/plugin-redirects": "3.33.0",
    "@payloadcms/plugin-search": "3.33.0",
    "@payloadcms/plugin-seo": "3.33.0",
    "@payloadcms/plugin-stripe": "3.33.0",
    "@payloadcms/richtext-lexical": "3.33.0",
    "@payloadcms/storage-s3": "3.33.0",
    "@payloadcms/ui": "3.33.0",
    "next": "^15.3.4",
    "nodemailer": "^6.9.0",
    "payload": "3.33.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.0.0",
    "postcss": "^8.0.0",
    "puppeteer-core": "^24.40.0",
    "sass": "^1.99.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
