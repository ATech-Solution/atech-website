# ============================================================
# .env.deploy — Local deploy configuration
# ============================================================
# Copy this file to .env.deploy and fill in your values.
# .env.deploy is gitignored — never commit it.
#
# Used by:
#   ./sync-media-to-uat.sh   — rsync local ./media/ to UAT server
# ============================================================

# UAT server SSH host (IP or hostname stored in GitHub secret SSH_HOST)
DEPLOY_UAT_HOST=

# Production server SSH host (for future use)
# DEPLOY_PROD_HOST=
