# ── Payload ──────────────────────────────────────────────────────────────────
# Secret key used to sign/verify JWTs — generate with: openssl rand -hex 32
PAYLOAD_SECRET=your-super-secret-key-change-me

# SQLite database file path (relative to project root)
DATABASE_URI=file:./data/payload.db

# ── Server URL ────────────────────────────────────────────────────────────────
# Shared fallback (used if env-specific override is not set)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Development override (used when NODE_ENV=development)
PAYLOAD_PUBLIC_SERVER_URL_DEV=http://localhost:3000

# Production override (used when NODE_ENV=production)
PAYLOAD_PUBLIC_SERVER_URL_PROD=https://your-domain.com

# ── Next.js (legacy — prefer PAYLOAD_PUBLIC_SERVER_URL above) ─────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Media ────────────────────────────────────────────────────────────────────
# Absolute path to the media upload directory.
# Defaults to {project_root}/media — set this in production so media
# survives across deployments (keep it outside the .next/standalone folder).
# PAYLOAD_MEDIA_DIR=/var/www/atech/media

# ── Maintenance Mode ──────────────────────────────────────────────────────────
# Set to "true" to show the under-construction page for all frontend routes.
# Admin panel (/admin) and API routes (/api) remain accessible.
# Restart PM2 after changing: pm2 restart company-profile
UNDER_CONSTRUCTION=false

# ── Email (SMTP — works with AWS SES, SendGrid, Mailgun, or any SMTP provider)
# Leave blank in development — email is a no-op when SMTP_USER is not set.
# SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@atech.com
# EMAIL_FROM_NAME=ATech
# ADMIN_EMAIL=admin@your-domain.com
#
# AWS SES legacy aliases (still supported, SMTP_* takes precedence)
# AWS_SES_SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
# AWS_SES_SMTP_PORT=465
# AWS_SES_SMTP_USER=
# AWS_SES_SMTP_PASSWORD=

# ── Stripe (optional) ────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
